rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.get('admin', false) == true;
    }

    function isDoctor() {
      return signedIn() && request.auth.token.get('doctor', false) == true;
    }

    function isVerifiedStaff() {
      return signedIn()
        && request.auth.token.email_verified == true
        && (isAdmin() || isDoctor());
    }

    function isCitizen() {
      return signedIn()
        && request.auth.token.get('admin', false) != true
        && request.auth.token.get('doctor', false) != true;
    }

    function validPhone(value) {
      return value is string && value.size() >= 7 && value.size() <= 20;
    }

    match /profiles/{uid} {
      allow create: if isCitizen()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll([
          'uid', 'email', 'displayName', 'phone', 'role', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'phone', 'role', 'createdAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 80
        && validPhone(request.resource.data.phone)
        && request.resource.data.role == 'citizen'
        && request.resource.data.createdAt == request.time;

      allow get: if signedIn()
        && (request.auth.uid == uid || (isAdmin() && request.auth.token.email_verified == true));
      allow list: if isAdmin() && request.auth.token.email_verified == true;

      allow update: if signedIn()
        && request.auth.uid == uid
        && resource.data.role == 'citizen'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'phone', 'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 80
        && validPhone(request.resource.data.phone)
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /appointments/{appointmentId} {
      allow create: if isCitizen()
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasAll([
          'citizenUid', 'citizenName', 'citizenEmail', 'phone',
          'preferredDate', 'preferredTime', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'citizenUid', 'citizenName', 'citizenEmail', 'phone',
          'preferredDate', 'preferredTime', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.citizenUid == request.auth.uid
        && request.resource.data.citizenName is string
        && request.resource.data.citizenName.size() >= 2
        && request.resource.data.citizenName.size() <= 80
        && request.resource.data.citizenEmail == request.auth.token.email
        && validPhone(request.resource.data.phone)
        && request.resource.data.preferredDate is string
        && request.resource.data.preferredDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.preferredTime in [
          '5:00 PM', '6:00 PM', '7:00 PM', '8:00 PM', '9:00 PM'
        ]
        && request.resource.data.status == 'requested'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow get, list: if signedIn()
        && (resource.data.citizenUid == request.auth.uid || isVerifiedStaff());

      allow update: if signedIn()
        && resource.data.citizenUid == request.auth.uid
        && resource.data.status == 'requested'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time;

      allow update: if isVerifiedStaff()
        && request.resource.data.status in [
          'requested', 'confirmed', 'completed', 'cancelled'
        ]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }
  }
}
